+/* COBOL-for-.NET: copy one generated piece into the merged .cs, then delete it */
+static void
+cs_append_and_remove (FILE *out, const char *name)
+{
+	FILE	*in = fopen (name, "rb");
+	char	buf[8192];
+	size_t	n;
+	if (!in) {
+		cobc_terminate (name);
+	}
+	while ((n = fread (buf, 1, sizeof (buf), in)) > 0) {
+		fwrite (buf, 1, n, out);
+	}
+	fclose (in);
+	remove (name);
+}
