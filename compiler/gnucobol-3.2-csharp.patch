 /* Output routines */
 
+/* COBOL-for-.NET: C# output mode (-fcsharp); all writes funnel through
+   cg_vprintf / cg_putc so the C# filter in csharp.c sees every byte */
+#include "csharp.c"
+
+static void
+cg_vprintf (FILE *fp, const char *fmt, va_list ap)
+{
+	if (cb_flag_csharp) {
+		static char	sbuf[8192];
+		char		*buf = sbuf;
+		va_list		ap2;
+		int		n;
+		va_copy (ap2, ap);
+		n = vsnprintf (sbuf, sizeof (sbuf), fmt, ap);
+		if (n >= (int)sizeof (sbuf)) {
+			buf = cobc_malloc ((size_t)n + 1);
+			vsnprintf (buf, (size_t)n + 1, fmt, ap2);
+		}
+		va_end (ap2);
+		cs_put (fp, buf);
+		if (buf != sbuf) {
+			cobc_free (buf);
+		}
+	} else {
+		vfprintf (fp, fmt, ap);
+	}
+}
+
+static void
+cg_putc (FILE *fp, int c)
+{
+	if (cb_flag_csharp) {
+		char b[2];
+		b[0] = (char)c;
+		b[1] = 0;
+		cs_put (fp, b);
+	} else {
+		fputc (c, fp);
+	}
+}
