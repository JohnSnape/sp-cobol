000010 IDENTIFICATION DIVISION.
000020 PROGRAM-ID. ACCEPT3.
000030 DATA DIVISION.
000040 WORKING-STORAGE SECTION.
000050 01  ARG-COUNT       PIC 99.
000060 01  CMD-LINE        PIC X(40).
000070 01  ENV-VALUE       PIC X(20).
000080 PROCEDURE DIVISION.
000090     ACCEPT ARG-COUNT FROM ARGUMENT-NUMBER
000100     DISPLAY "ARGUMENTS:    " ARG-COUNT
000110     ACCEPT CMD-LINE FROM COMMAND-LINE
000120     DISPLAY "COMMAND LINE: [" CMD-LINE "]"
000130     SET ENVIRONMENT "ACCEPT3_MODE" TO "TEST"
000140     ACCEPT ENV-VALUE FROM ENVIRONMENT "ACCEPT3_MODE"
000150     DISPLAY "ACCEPT3_MODE: [" ENV-VALUE "]"
000160     MOVE "OLD VALUE" TO ENV-VALUE
000170     ACCEPT ENV-VALUE FROM ENVIRONMENT "ACCEPT3_NOT_SET"
000180         ON EXCEPTION
000190             DISPLAY "NOT SET:      [" ENV-VALUE "]" END-DISPLAY
000200         NOT ON EXCEPTION
000210             DISPLAY "FOUND:        [" ENV-VALUE "]"
000220     END-ACCEPT
000230     STOP RUN.
