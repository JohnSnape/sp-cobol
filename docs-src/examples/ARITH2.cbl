000010 IDENTIFICATION DIVISION.
000020 PROGRAM-ID. ARITH2.
000030 DATA DIVISION.
000040 WORKING-STORAGE SECTION.
000050 01  A                   PIC 99    VALUE 10.
000060 01  B                   PIC 99    VALUE 4.
000070 01  N                   PIC 99    VALUE 1.
000080 PROCEDURE DIVISION.
000090     IF A * 2 > B + 10
000100         DISPLAY "A * 2 IS MORE THAN B + 10"
000110     END-IF
000120     IF (A - B) * 3 = 18
000130         DISPLAY "(A - B) * 3 IS 18"
000140     END-IF
000150     PERFORM UNTIL N * N > 30
000160         ADD 1 TO N
000170     END-PERFORM
000180     DISPLAY "FIRST N WITH N * N > 30: " N
000190     EVALUATE TRUE
000200         WHEN A / B < 2
000210             DISPLAY "A / B IS UNDER 2"
000220         WHEN A / B < 3
000230             DISPLAY "A / B IS 2 OR MORE, UNDER 3"
000240         WHEN OTHER
000250             DISPLAY "A / B IS 3 OR MORE"
000260     END-EVALUATE
000270     STOP RUN.
