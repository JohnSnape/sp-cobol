000010 IDENTIFICATION DIVISION.
000020 PROGRAM-ID. COMPUTE1.
000030 DATA DIVISION.
000040 WORKING-STORAGE SECTION.
000050 01  PRICE           PIC 9(3)V99 VALUE 19.99.
000060 01  QTY             PIC 9(3)    VALUE 3.
000070 01  TAX-RATE        PIC V999    VALUE .075.
000080 01  TOTAL           PIC 9(4)V99.
000090 01  CUT             PIC 9(4)V9.
000100 01  NEAR            PIC 9(4)V9.
000110 01  AVERAGE         PIC 9(3)V99 VALUE 5.
000120 01  SMALL           PIC 99      VALUE 42.
000130 01  ZERO-QTY        PIC 9       VALUE 0.
000140 PROCEDURE DIVISION.
000150     COMPUTE TOTAL = PRICE * QTY * (1 + TAX-RATE)
000160     DISPLAY "TOTAL     " TOTAL
000170     COMPUTE CUT NEAR ROUNDED = PRICE * QTY * (1 + TAX-RATE)
000180     DISPLAY "TRUNCATED " CUT "  ROUNDED " NEAR
000190     COMPUTE SMALL EQUAL QTY ** 4
000200         ON SIZE ERROR DISPLAY "81 DOESN'T FIT? SMALL " SMALL
000210         NOT ON SIZE ERROR DISPLAY "3 ** 4 = " SMALL
000220     END-COMPUTE
000230     COMPUTE SMALL = QTY ** 5
000240         ON SIZE ERROR DISPLAY "243 TOO BIG, SMALL STAYS " SMALL
000250     END-COMPUTE
000260     COMPUTE AVERAGE = TOTAL / ZERO-QTY
000270         ON SIZE ERROR
000280             DISPLAY "DIVIDE BY ZERO, AVERAGE STAYS " AVERAGE
000290     END-COMPUTE
000300     STOP RUN.
