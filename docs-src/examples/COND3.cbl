000010 IDENTIFICATION DIVISION.
000020 PROGRAM-ID. COND3.
000030 DATA DIVISION.
000040 WORKING-STORAGE SECTION.
000050 01  A                   PIC 9     VALUE 1.
000060 01  WHOLE               PIC 9(3)  VALUE 5.
000070 01  WITH-CENTS          PIC 9V99  VALUE 5.00.
000080 PROCEDURE DIVISION.
000090     IF WHOLE = WITH-CENTS
000100         DISPLAY WHOLE " EQUALS " WITH-CENTS
000110     END-IF
000120     IF A <> 2
000130         DISPLAY "A <> 2"
000140     END-IF
000150     IF A NOT = 1 OR 2
000160         DISPLAY "A NOT = 1 OR 2: TRUE, EVEN THOUGH A IS 1"
000170     END-IF
000180     IF NOT (A = 1 OR A = 2)
000190         DISPLAY "NOT SHOWN"
000200     ELSE
000210         DISPLAY "NOT (A = 1 OR A = 2): FALSE"
000220     END-IF
000230     STOP RUN.
