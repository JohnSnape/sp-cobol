000010 IDENTIFICATION DIVISION.
000020 PROGRAM-ID. FILES1.
000030 ENVIRONMENT DIVISION.
000040 INPUT-OUTPUT SECTION.
000050 FILE-CONTROL.
000060     SELECT PAYFILE ASSIGN TO "pay.dat"
000070         ORGANIZATION IS SEQUENTIAL
000080         FILE STATUS IS PAY-STATUS.
000090 DATA DIVISION.
000100 FILE SECTION.
000110 FD  PAYFILE
000120     BLOCK CONTAINS 10 RECORDS
000130     RECORD CONTAINS 14 CHARACTERS.
000140 01  PAY-REC.
000150     05  PAY-NAME        PIC X(8).
000160     05  PAY-AMOUNT      PIC 9(4)V99.
000170 WORKING-STORAGE SECTION.
000180 01  PAY-STATUS          PIC XX.
000190 01  END-FLAG            PIC X VALUE "N".
000200     88  NO-MORE         VALUE "Y".
000210 PROCEDURE DIVISION.
000220*    write three records
000230     OPEN OUTPUT PAYFILE
000240     MOVE "ANNA" TO PAY-NAME  MOVE 1250.00 TO PAY-AMOUNT
000250     WRITE PAY-REC
000260     MOVE "BEN" TO PAY-NAME   MOVE 980.50 TO PAY-AMOUNT
000270     WRITE PAY-REC
000280     MOVE "CARLA" TO PAY-NAME MOVE 1100.25 TO PAY-AMOUNT
000290     WRITE PAY-REC
000300     CLOSE PAYFILE
000310     DISPLAY "WROTE 3 RECORDS, STATUS " PAY-STATUS
000320*    read them back
000330     OPEN INPUT PAYFILE
000340     PERFORM UNTIL NO-MORE
000350         READ PAYFILE
000360             AT END SET NO-MORE TO TRUE
000370             NOT AT END DISPLAY PAY-NAME " " PAY-AMOUNT
000380         END-READ
000390     END-PERFORM
000400     DISPLAY "AT END, STATUS " PAY-STATUS
000410     CLOSE PAYFILE
000420     STOP RUN.
