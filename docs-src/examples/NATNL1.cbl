000010 IDENTIFICATION DIVISION.
000020 PROGRAM-ID. NATNL1.
000030 DATA DIVISION.
000040 WORKING-STORAGE SECTION.
000050 01  GREETING          PIC N(5)    VALUE N"HELLO".
000060 01  NAME-N            PIC N(5).
000070 01  SHORT-N           PIC N(3).
000080 01  PADDED-N          PIC N(4).
000090 PROCEDURE DIVISION.
000100     DISPLAY "[" GREETING "]"
000110     DISPLAY "CHARACTERS " FUNCTION LENGTH(GREETING)
000120             ", BYTES " FUNCTION BYTE-LENGTH(GREETING)
000130     MOVE N"WORLD" TO NAME-N
000140     DISPLAY "[" NAME-N "]"
000150     MOVE GREETING TO SHORT-N
000160     DISPLAY "[" SHORT-N "]"
000170     IF GREETING = N"HELLO"
000180         DISPLAY "EQUAL"
000190     END-IF
000200     MOVE N"HI" TO PADDED-N
000210     DISPLAY "[" PADDED-N "]"
000220     STOP RUN.
