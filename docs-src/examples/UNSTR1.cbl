000010 IDENTIFICATION DIVISION.
000020 PROGRAM-ID. UNSTR1.
000030 DATA DIVISION.
000040 WORKING-STORAGE SECTION.
000050 01  CSV-LINE       PIC X(30) VALUE "SMITH,JOHN,,SAN DIEGO".
000060 01  F1             PIC X(8).
000070 01  F2             PIC X(8).
000080 01  F3             PIC X(8).
000090 01  F4             PIC X(8).
000100 01  LEN1           PIC 99.
000110 01  LEN4           PIC 99.
000120 01  FIELDS         PIC 99.
000130 01  WORDS-IN       PIC X(30) VALUE "ONE   TWO;THREE FOUR".
000140 01  DLM            PIC X.
000150 01  PTR            PIC 99.
000160 PROCEDURE DIVISION.
000170     MOVE 0 TO FIELDS
000180     UNSTRING CSV-LINE DELIMITED BY ","
000190         INTO F1 COUNT IN LEN1
000200              F2 F3
000210              F4 COUNT IN LEN4
000220         TALLYING IN FIELDS
000230     END-UNSTRING
000240     DISPLAY "[" F1 "][" F2 "][" F3 "][" F4 "]"
000250     DISPLAY "LENGTHS " LEN1 " " LEN4 "  FIELDS FILLED " FIELDS
000260     MOVE 1 TO PTR
000270     UNSTRING WORDS-IN DELIMITED BY ALL SPACE OR ";"
000280         INTO F1 DELIMITER IN DLM
000290              F2
000300         WITH POINTER PTR
000310         ON OVERFLOW DISPLAY "MORE TEXT LEFT AT POSITION " PTR
000320         NOT ON OVERFLOW DISPLAY "ALL TEXT USED"
000330     END-UNSTRING
000340     DISPLAY "[" F1 "] ENDED BY [" DLM "]  [" F2 "]"
000350     UNSTRING WORDS-IN DELIMITED BY ALL SPACE OR ";"
000360         INTO F3 F4
000370         WITH POINTER PTR
000380     END-UNSTRING
000390     DISPLAY "REST: [" F3 "][" F4 "]"
000400     STOP RUN.
