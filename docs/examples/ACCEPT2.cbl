000010 IDENTIFICATION DIVISION.
000020 PROGRAM-ID. ACCEPT2.
000030 DATA DIVISION.
000040 WORKING-STORAGE SECTION.
000050 01  TODAY-8         PIC 9(8).
000060 01  TODAY-6         PIC 9(6).
000070 01  JULIAN-7        PIC 9(7).
000080 01  WEEK-DAY        PIC 9.
000090 01  NOW-TIME.
000100     05  NOW-HH      PIC 99.
000110     05  NOW-MM      PIC 99.
000120     05  NOW-SS      PIC 99.
000130     05  NOW-CC      PIC 99.
000140 PROCEDURE DIVISION.
000150     ACCEPT TODAY-8 FROM DATE YYYYMMDD
000160     IF FUNCTION TEST-DATE-YYYYMMDD (TODAY-8) = 0
000170         DISPLAY "DATE YYYYMMDD: a valid date"
000180     END-IF
000190     ACCEPT TODAY-6 FROM DATE
000200     IF TODAY-6 = TODAY-8 (3:6)
000210         DISPLAY "DATE:          the same day as YYMMDD"
000220     END-IF
000230     ACCEPT JULIAN-7 FROM DAY YYYYDDD
000240     IF FUNCTION TEST-DAY-YYYYDDD (JULIAN-7) = 0
000250         DISPLAY "DAY YYYYDDD:   a valid year and day"
000260     END-IF
000270     ACCEPT WEEK-DAY FROM DAY-OF-WEEK
000280     IF WEEK-DAY >= 1 AND WEEK-DAY <= 7
000290         DISPLAY "DAY-OF-WEEK:   between 1 and 7"
000300     END-IF
000310     ACCEPT NOW-TIME FROM TIME
000320     IF NOW-HH < 24 AND NOW-MM < 60 AND NOW-SS < 60
000330         DISPLAY "TIME:          hours, minutes, seconds"
000340     END-IF
000350     STOP RUN.
