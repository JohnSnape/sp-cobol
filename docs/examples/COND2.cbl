000010 IDENTIFICATION DIVISION.
000020 PROGRAM-ID. COND2.
000030 DATA DIVISION.
000040 WORKING-STORAGE SECTION.
000050 01  AGE                 PIC 99    VALUE 15.
000060 01  CODE-X              PIC 9     VALUE 3.
000070 01  MEMBER-FLAG         PIC X     VALUE "Y".
000080     88  IS-MEMBER                 VALUE "Y".
000090 PROCEDURE DIVISION.
000100     IF AGE > 12 AND AGE < 20
000110         DISPLAY "A TEENAGER"
000120     END-IF
000130     IF AGE > 12 AND < 20
000140         DISPLAY "STILL A TEENAGER (ABBREVIATED)"
000150     END-IF
000160     IF CODE-X = 1 OR 3 OR 5
000170         DISPLAY "CODE-X IS 1, 3 OR 5"
000180     END-IF
000190     IF NOT CODE-X = 2
000200         DISPLAY "NOT CODE-X = 2"
000210     END-IF
000220     IF IS-MEMBER AND AGE < 18
000230         DISPLAY "A YOUNG MEMBER"
000240     END-IF
000250*    AND IS DONE BEFORE OR
000260     IF CODE-X = 9 AND AGE = 99 OR IS-MEMBER
000270         DISPLAY "WITHOUT PARENTHESES: TRUE"
000280     END-IF
000290     IF CODE-X = 9 AND (AGE = 99 OR IS-MEMBER)
000300         DISPLAY "WITH PARENTHESES: TRUE"
000310     ELSE
000320         DISPLAY "WITH PARENTHESES: FALSE"
000330     END-IF
000340     STOP RUN.
