000010 IDENTIFICATION DIVISION.
000020 PROGRAM-ID. FIGCON1.
000030 DATA DIVISION.
000040 WORKING-STORAGE SECTION.
000050 01  TEXT-6              PIC X(6)  VALUE SPACES.
000060 01  NUM-4               PIC 9(4)  VALUE ZERO.
000070 01  BYTE-VALUE          PIC 999.
000080 PROCEDURE DIVISION.
000090     DISPLAY "VALUE SPACES:  [" TEXT-6 "]"
000100     DISPLAY "VALUE ZERO:    [" NUM-4 "]"
000110     MOVE ZEROS TO TEXT-6
000120     DISPLAY "ZEROS:         [" TEXT-6 "]"
000130     MOVE ALL "AB" TO TEXT-6
000140     DISPLAY "ALL ""AB"":      [" TEXT-6 "]"
000150     MOVE ALL "*" TO TEXT-6
000160     DISPLAY "ALL ""*"":       [" TEXT-6 "]"
000170     MOVE QUOTES TO TEXT-6
000180     DISPLAY "QUOTES:        [" TEXT-6 "]"
000190     MOVE SPACE TO TEXT-6
000200     DISPLAY "SPACE:         [" TEXT-6 "]"
000210     MOVE HIGH-VALUES TO TEXT-6
000220     COMPUTE BYTE-VALUE = FUNCTION ORD (TEXT-6 (1:1)) - 1
000230     DISPLAY "HIGH-VALUES:   FIRST BYTE IS " BYTE-VALUE
000240     MOVE LOW-VALUES TO TEXT-6
000250     COMPUTE BYTE-VALUE = FUNCTION ORD (TEXT-6 (1:1)) - 1
000260     DISPLAY "LOW-VALUES:    FIRST BYTE IS " BYTE-VALUE
000270     MOVE 1234 TO NUM-4
000280     MOVE ZEROES TO NUM-4
000290     DISPLAY "ZEROES:        [" NUM-4 "]"
000300     MOVE "ABC" TO TEXT-6
000310     IF TEXT-6 (4:3) = SPACES
000320         DISPLAY "THE LAST THREE BYTES ARE SPACES"
000330     END-IF
000340     STOP RUN.
