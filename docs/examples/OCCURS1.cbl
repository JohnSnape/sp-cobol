000010 IDENTIFICATION DIVISION.
000020 PROGRAM-ID. OCCURS1.
000030 DATA DIVISION.
000040 WORKING-STORAGE SECTION.
000050 01  SALES-TABLE.
000060     05  REGION        OCCURS 2.
000070         10  REG-NAME  PIC X(5).
000080         10  QTR-SALES PIC 9(4) OCCURS 4.
000090 01  R                 PIC 9.
000100 01  Q                 PIC 9.
000110 01  REG-TOTAL         PIC 9(5).
000120 PROCEDURE DIVISION.
000130     MOVE "NORTH" TO REG-NAME(1)
000140     MOVE "SOUTH" TO REG-NAME(2)
000150     PERFORM VARYING R FROM 1 BY 1 UNTIL R > 2
000160         PERFORM VARYING Q FROM 1 BY 1 UNTIL Q > 4
000170             COMPUTE QTR-SALES(R, Q) = R * 100 + Q * 10
000180         END-PERFORM
000190     END-PERFORM
000200     PERFORM VARYING R FROM 1 BY 1 UNTIL R > 2
000210         MOVE 0 TO REG-TOTAL
000220         PERFORM VARYING Q FROM 1 BY 1 UNTIL Q > 4
000230             ADD QTR-SALES(R, Q) TO REG-TOTAL
000240         END-PERFORM
000250         DISPLAY REG-NAME(R) " Q1 " QTR-SALES(R, 1) " Q4 "
000260                 QTR-SALES(R, 4) " TOTAL " REG-TOTAL
000270     END-PERFORM
000280     DISPLAY "SOUTH, LAST QUARTER: " QTR-SALES(2 4)
000290     MOVE 1 TO R
000300     DISPLAY "SUBSCRIPT R + 1, 2: " QTR-SALES(R + 1, 2)
000310     DISPLAY "WHOLE REGION 1: [" REGION(1) "]"
000320     DISPLAY "TABLE IS " LENGTH OF SALES-TABLE " BYTES"
000330     STOP RUN.
