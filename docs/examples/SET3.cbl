000010 IDENTIFICATION DIVISION.
000020 PROGRAM-ID. SET3.
000030 DATA DIVISION.
000040 WORKING-STORAGE SECTION.
000050 01  GREETING       PIC X(5) VALUE "HELLO".
000060 01  FAREWELL       PIC X(5) VALUE "BYE  ".
000070 01  PTR            USAGE POINTER VALUE NULL.
000080 LINKAGE SECTION.
000090 01  VIEW           PIC X(5).
000100 PROCEDURE DIVISION.
000110     IF PTR = NULL
000120         DISPLAY "PTR STARTS AS NULL"
000130     END-IF
000140     SET PTR TO ADDRESS OF GREETING
000150     SET ADDRESS OF VIEW TO PTR
000160     DISPLAY "VIEW THROUGH PTR: " VIEW
000170     SET PTR TO ADDRESS OF FAREWELL
000180     SET ADDRESS OF VIEW TO PTR
000190     DISPLAY "VIEW THROUGH PTR: " VIEW
000200     SET PTR TO NULL
000210     IF PTR = NULL
000220         DISPLAY "PTR IS NULL AGAIN"
000230     END-IF
000240     STOP RUN.
