<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CobolDotNet.Runtime</RootNamespace>
    <AssemblyName>CobolDotNet.Runtime</AssemblyName>
    <!-- Member names mirror libcob's C API (cob_move, cob_display, ...) on purpose,
         so generated code maps 1:1 onto GnuCOBOL's code generator. -->
    <NoWarn>$(NoWarn);IDE1006;CS8981</NoWarn>
  </PropertyGroup>

</Project>
