000010* Binary and packed counters: compare, add, subtract and set
000020* in place, signed and unsigned, every size, both byte orders.
000030 IDENTIFICATION DIVISION.
000040 PROGRAM-ID. BINOPS.
000050 DATA DIVISION.
000060 WORKING-STORAGE SECTION.
000070 01 B1             PIC S9(2)     COMP.
000080 01 B2             PIC S9(4)     COMP.
000090 01 B3             PIC 9(6)      COMP.
000100 01 B4             PIC S9(9)     COMP.
000110 01 B5             PIC 9(11)     COMP.
000120 01 B6             PIC S9(14)    COMP.
000130 01 B7             PIC 9(16)     COMP.
000140 01 B8             PIC S9(18)    COMP.
000150 01 N2             PIC S9(4)     COMP-5.
000160 01 N4             PIC 9(9)      COMP-5.
000170 01 N8             PIC S9(18)    COMP-5.
000180 01 P3             PIC S9(5)     COMP-3.
000190 01 HITS           PIC 9(4)      VALUE 0.
000200 PROCEDURE DIVISION.
000210 MAIN-PARA.
000220     PERFORM VARYING B2 FROM -5 BY 1 UNTIL B2 > 5
000230        IF B2 < 0 ADD 1 TO HITS END-IF
000240     END-PERFORM
000250     DISPLAY "NEGATIVES " HITS " B2 " B2
000260     MOVE 99 TO B1
000270     SUBTRACT 100 FROM B1
000280     DISPLAY "B1 " B1
000290     MOVE 999990 TO B3
000300     ADD 9 TO B3
000310     DISPLAY "B3 " B3
000320     MOVE -123456789 TO B4
000330     ADD 1 TO B4
000340     IF B4 = -123456788 DISPLAY "B4 OK " B4 END-IF
000350     MOVE 12345678901 TO B5
000360     SUBTRACT 1 FROM B5
000370     DISPLAY "B5 " B5
000380     MOVE -9999999999999 TO B6
000390     IF B6 < -9999999999998 DISPLAY "B6 OK " B6 END-IF
000400     MOVE 1234567890123456 TO B7
000410     ADD 4 TO B7
000420     DISPLAY "B7 " B7
000430     MOVE -999999999999999999 TO B8
000440     ADD 1 TO B8
000450     DISPLAY "B8 " B8
000460     MOVE 0 TO HITS
000470     PERFORM VARYING N2 FROM 10 BY -3 UNTIL N2 < -10
000480        ADD 1 TO HITS
000490     END-PERFORM
000500     DISPLAY "N2 " N2 " STEPS " HITS
000510     MOVE 4000000000 TO N4
000520     ADD 5 TO N4
000530     IF N4 > 4000000000 DISPLAY "N4 " N4 END-IF
000540     MOVE -5 TO N8
000550     SUBTRACT 10 FROM N8
000560     DISPLAY "N8 " N8
000570     MOVE 0 TO HITS
000580     PERFORM VARYING P3 FROM -3 BY 2 UNTIL P3 > 7
000590        ADD 1 TO HITS
000600     END-PERFORM
000610     DISPLAY "P3 " P3 " STEPS " HITS
000620     STOP RUN.
