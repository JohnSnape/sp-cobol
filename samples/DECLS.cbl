000010* DECLARATIVES: USE AFTER ERROR procedures for one file and for
000020* an OPEN mode, the FILE STATUS seen inside them, and what
000030* happens after the procedure returns.
000040 IDENTIFICATION DIVISION.
000050 PROGRAM-ID. DECLS.
000060 ENVIRONMENT DIVISION.
000070 INPUT-OUTPUT SECTION.
000080 FILE-CONTROL.
000090     SELECT MISSING ASSIGN TO "missing.dat"
000100        ORGANIZATION SEQUENTIAL FILE STATUS FS-M.
000110     SELECT DATA1 ASSIGN TO "data1.dat"
000120        ORGANIZATION SEQUENTIAL FILE STATUS FS-D.
000130     SELECT REL ASSIGN TO "rel.dat"
000140        ORGANIZATION RELATIVE ACCESS RANDOM
000150        RELATIVE KEY RK FILE STATUS FS-R.
000160     SELECT NOSTAT ASSIGN TO "nostat.dat"
000170        ORGANIZATION SEQUENTIAL.
000180     SELECT OUTF ASSIGN TO "out.dat"
000190        ORGANIZATION SEQUENTIAL FILE STATUS FS-O.
000200 DATA DIVISION.
000210 FILE SECTION.
000220 FD MISSING.
000230 01 M-REC          PIC X(10).
000240 FD DATA1.
000250 01 D-REC          PIC X(10).
000260 FD REL.
000270 01 R-REC          PIC X(10).
000280 FD NOSTAT.
000290 01 N-REC          PIC X(10).
000300 FD OUTF.
000310 01 O-REC          PIC X(10).
000320 WORKING-STORAGE SECTION.
000330 01 FS-M           PIC XX.
000340 01 FS-D           PIC XX.
000350 01 FS-R           PIC XX.
000360 01 FS-O           PIC XX.
000370 01 RK             PIC 99.
000380 01 ERRORS         PIC 99 VALUE 0.
000390 PROCEDURE DIVISION.
000400 DECLARATIVES.
000410 MISSING-ERR SECTION.
000420     USE AFTER STANDARD ERROR PROCEDURE ON MISSING.
000430 MISSING-ERR-PARA.
000440     ADD 1 TO ERRORS
000450     DISPLAY "  IN MISSING-ERR, STATUS " FS-M.
000460 INPUT-ERR SECTION.
000470     USE AFTER ERROR PROCEDURE ON INPUT.
000480 INPUT-ERR-PARA.
000490     ADD 1 TO ERRORS
000500     DISPLAY "  IN INPUT-ERR, STATUS " FS-D.
000510 REL-ERR SECTION.
000520     USE AFTER EXCEPTION PROCEDURE ON REL.
000530 REL-ERR-PARA.
000540     ADD 1 TO ERRORS
000550     DISPLAY "  IN REL-ERR, STATUS " FS-R.
000560 NOSTAT-ERR SECTION.
000570     USE AFTER ERROR PROCEDURE ON NOSTAT.
000580 NOSTAT-ERR-PARA.
000590     ADD 1 TO ERRORS
000600     DISPLAY "  IN NOSTAT-ERR (NO FILE STATUS CLAUSE)".
000610 OUTPUT-ERR SECTION.
000620     USE AFTER ERROR PROCEDURE ON OUTPUT.
000630 OUTPUT-ERR-PARA.
000640     ADD 1 TO ERRORS
000650     DISPLAY "  IN OUTPUT-ERR, STATUS " FS-O.
000660 END DECLARATIVES.
000670 MAIN SECTION.
000680 MAIN-PARA.
000690     DISPLAY "OPEN MISSING"
000700     OPEN INPUT MISSING
000710     DISPLAY "AFTER, STATUS " FS-M
000720     OPEN OUTPUT DATA1
000730     MOVE "ONE" TO D-REC WRITE D-REC
000740     CLOSE DATA1
000750     OPEN INPUT DATA1
000760     READ DATA1
000770     DISPLAY "READ 1 " FS-D
000780     READ DATA1
000790     DISPLAY "READ 2 (AT END, NO AT END PHRASE) " FS-D
000800     READ DATA1 AT END DISPLAY "READ 3 AT END PHRASE " FS-D
000810     END-READ
000820     CLOSE DATA1
000830     OPEN OUTPUT REL
000840     MOVE 3 TO RK MOVE "X" TO R-REC WRITE R-REC
000850     WRITE R-REC
000860     DISPLAY "DUP WRITE " FS-R
000870     WRITE R-REC INVALID KEY DISPLAY "INVALID KEY PHRASE " FS-R
000880     END-WRITE
000890     CLOSE REL
000900     OPEN INPUT NOSTAT
000910     DISPLAY "STILL RUNNING AFTER NOSTAT"
000920     OPEN OUTPUT OUTF
000930     READ OUTF
000940     DISPLAY "READ ON OUTPUT " FS-O
000950     CLOSE OUTF
000960     DISPLAY "ERRORS HANDLED " ERRORS
000970     STOP RUN.
