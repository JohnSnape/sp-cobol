000010* Where SP COBOL deliberately differs from stock GnuCOBOL 3.2
000020* (DECISIONS.md, File I/O): stock bugs fixed. Expected output is
000030* written by hand, not by stock. The program ends with the
000040* error message for a missing file with no FILE STATUS.
000050 IDENTIFICATION DIVISION.
000060 PROGRAM-ID. FILEFIX.
000070 ENVIRONMENT DIVISION.
000080 INPUT-OUTPUT SECTION.
000090 FILE-CONTROL.
000100     SELECT TEXTF ASSIGN TO "tabs.txt"
000110        ORGANIZATION LINE SEQUENTIAL FILE STATUS FS.
000120     SELECT RAWF ASSIGN TO "unix.txt"
000130        ORGANIZATION SEQUENTIAL FILE STATUS FS.
000140     SELECT UNIXF ASSIGN TO "unix.txt"
000150        ORGANIZATION LINE SEQUENTIAL FILE STATUS FS.
000160     SELECT QUOTEF ASSIGN TO "'quoted.dat'"
000170        ORGANIZATION SEQUENTIAL FILE STATUS FS.
000180     SELECT RELF ASSIGN TO "holes.rel"
000190        ORGANIZATION RELATIVE ACCESS RANDOM
000200        RELATIVE KEY RK FILE STATUS FS.
000210     SELECT NOFILE ASSIGN TO "no-such-file.dat"
000220        ORGANIZATION SEQUENTIAL.
000230 DATA DIVISION.
000240 FILE SECTION.
000250 FD TEXTF.
000260 01 TREC           PIC X(10).
000270 FD RAWF.
000280 01 RAWREC         PIC X(12).
000290 FD UNIXF.
000300 01 UREC           PIC X(6).
000310 FD QUOTEF.
000320 01 QREC           PIC X(4).
000330 FD RELF.
000340 01 RREC           PIC X(4).
000350 FD NOFILE.
000360 01 NREC           PIC X(4).
000370 WORKING-STORAGE SECTION.
000380 01 FS             PIC XX.
000390 01 RK             PIC 9(4).
000400 PROCEDURE DIVISION.
000410 MAIN-PARA.
000420*    TAB in a line sequential record: stock 71, here 00
000430     OPEN OUTPUT TEXTF
000440     MOVE "A" TO TREC
000450     MOVE X"09" TO TREC(2:1)
000460     MOVE "B" TO TREC(3:1)
000470     WRITE TREC
000480     DISPLAY "TAB WRITE    " FS
000490     CLOSE TEXTF
000500     OPEN INPUT TEXTF
000510     READ TEXTF
000520     IF TREC(2:1) = X"09"
000530        DISPLAY "TAB READ     " FS " TAB KEPT"
000540     END-IF
000550     CLOSE TEXTF
000560*    LF-only lines and a Ctrl-Z byte: read as data
000570     OPEN OUTPUT RAWF
000580     MOVE "ONE" TO RAWREC
000590     MOVE X"0A" TO RAWREC(4:1)
000600     MOVE "TWO" TO RAWREC(5:3)
000610     MOVE X"1A" TO RAWREC(8:1)
000620     MOVE "Z" TO RAWREC(9:1)
000630     MOVE X"0A" TO RAWREC(10:1)
000640     MOVE "END" TO RAWREC(11:2)
000650     WRITE RAWREC
000660     CLOSE RAWF
000670     OPEN INPUT UNIXF
000680     READ UNIXF DISPLAY "LF LINE 1    " FS " [" UREC "]"
000690     READ UNIXF DISPLAY "CTRL-Z LINE  " FS
000700     READ UNIXF DISPLAY "LF LINE 3    " FS " [" UREC "]"
000710     READ UNIXF DISPLAY "END          " FS
000720     CLOSE UNIXF
000730*    quotes around a file name are removed: stock 30
000740     OPEN OUTPUT QUOTEF
000750     DISPLAY "QUOTED NAME  " FS
000760     CLOSE QUOTEF
000770*    empty relative slot: REWRITE and DELETE say 23 (stock 00)
000780     OPEN OUTPUT RELF
000790     MOVE 1 TO RK MOVE "ONE" TO RREC WRITE RREC
000800     MOVE 3 TO RK MOVE "3RD" TO RREC WRITE RREC
000810     CLOSE RELF
000820     OPEN I-O RELF
000830     MOVE 2 TO RK
000840     REWRITE RREC
000850     DISPLAY "REWRITE HOLE " FS
000860     DELETE RELF
000870     DISPLAY "DELETE HOLE  " FS
000880     CLOSE RELF
000890*    no FILE STATUS: the program stops with a message
000900     OPEN OUTPUT TEXTF
000910     OPEN INPUT NOFILE
000920     DISPLAY "NOT REACHED"
000930     STOP RUN.
