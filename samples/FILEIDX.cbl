001050*    sequential access: keys must ascend
001060     OPEN OUTPUT SEQX
001070     MOVE "10TEN" TO SX-REC WRITE SX-REC
001080     MOVE "20TWENTY" TO SX-REC WRITE SX-REC
001090     MOVE "15FIFTN" TO SX-REC
001100     WRITE SX-REC INVALID KEY DISPLAY "OUT OF ORDER    " FS
001110     END-WRITE
001120     CLOSE SEQX
001130     OPEN EXTEND SEQX
001140     MOVE "05FIVE" TO SX-REC
001150     WRITE SX-REC INVALID KEY DISPLAY "EXTEND LOWER    " FS
001160     END-WRITE
001170     MOVE "30THIRTY" TO SX-REC WRITE SX-REC
001180     DISPLAY "EXTEND HIGHER   " FS
001190     CLOSE SEQX
001200     OPEN INPUT SEQX
001210     MOVE "N" TO EOF-FLAG
001220     PERFORM UNTIL AT-EOF
001230        READ SEQX AT END SET AT-EOF TO TRUE
001240           NOT AT END DISPLAY "  " SX-REC
001250        END-READ
001260     END-PERFORM
001270     CLOSE SEQX
001280     STOP RUN.
001290 READ-ALL.
001300     MOVE "N" TO EOF-FLAG
001310     PERFORM UNTIL AT-EOF
