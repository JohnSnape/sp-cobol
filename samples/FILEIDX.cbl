000010* Indexed files (SP COBOL's own format; no stock reference, so
000020* the expected output was worked out by hand): primary and
000030* alternate keys with duplicates, random/dynamic/sequential.
000040 IDENTIFICATION DIVISION.
000050 PROGRAM-ID. FILEIDX.
000060 ENVIRONMENT DIVISION.
000070 INPUT-OUTPUT SECTION.
000080 FILE-CONTROL.
000090     SELECT CUST ASSIGN TO "customers.idx"
000100        ORGANIZATION INDEXED ACCESS DYNAMIC
000110        RECORD KEY CUST-ID
000120        ALTERNATE RECORD KEY CUST-CITY WITH DUPLICATES
000130        FILE STATUS FS.
000140     SELECT CUST2 ASSIGN TO "customers.idx"
000150        ORGANIZATION INDEXED ACCESS DYNAMIC
000160        RECORD KEY C2-NAME
000170        FILE STATUS FS.
000180     SELECT SEQX ASSIGN TO "ordered.idx"
000190        ORGANIZATION INDEXED ACCESS SEQUENTIAL
000200        RECORD KEY SX-KEY FILE STATUS FS.
000210 DATA DIVISION.
000220 FILE SECTION.
000230 FD CUST.
000240 01 CUST-REC.
000250    05 CUST-ID     PIC 9(4).
000260    05 CUST-NAME   PIC X(8).
000270    05 CUST-CITY   PIC X(8).
000280 FD CUST2.
000290 01 C2-REC.
000300    05 C2-ID       PIC 9(4).
000310    05 C2-NAME     PIC X(8).
000320    05 C2-CITY     PIC X(8).
000330 FD SEQX.
000340 01 SX-REC.
000350    05 SX-KEY      PIC 99.
000360    05 SX-DATA     PIC X(6).
000370 WORKING-STORAGE SECTION.
000380 01 FS             PIC XX.
000390 01 EOF-FLAG       PIC X.
000400    88 AT-EOF      VALUE "Y".
000410 PROCEDURE DIVISION.
000420 MAIN-PARA.
000430     OPEN OUTPUT CUST
000440     MOVE "1003ALICE   BOSTON  " TO CUST-REC WRITE CUST-REC
000450     DISPLAY "WRITE 1003      " FS
000460     MOVE "1001BOB     DENVER  " TO CUST-REC WRITE CUST-REC
000470     DISPLAY "WRITE 1001      " FS
000480     MOVE "1005CAROL   BOSTON  " TO CUST-REC WRITE CUST-REC
000490     DISPLAY "WRITE 1005 DUP  " FS
000500     MOVE "1002DAVE    AUSTIN  " TO CUST-REC WRITE CUST-REC
000510     DISPLAY "WRITE 1002      " FS
000520     MOVE "1001BOBBY   DENVER  " TO CUST-REC
000530     WRITE CUST-REC INVALID KEY DISPLAY "WRITE 1001 AGAIN " FS
000540     END-WRITE
000550     CLOSE CUST
000560     OPEN I-O CUST
000570     MOVE 1002 TO CUST-ID
000580     READ CUST KEY IS CUST-ID
000590     DISPLAY "READ 1002       " FS " " CUST-REC
000600     MOVE 1004 TO CUST-ID
000610     READ CUST INVALID KEY DISPLAY "READ 1004       " FS
000620     END-READ
000630     MOVE 1002 TO CUST-ID READ CUST
000640     READ CUST NEXT
000650     DISPLAY "NEXT AFTER 1002 " FS " " CUST-REC
000660     MOVE 1000 TO CUST-ID
000670     START CUST KEY >= CUST-ID
000680     DISPLAY "START >= 1000   " FS
000690     PERFORM READ-ALL
000700     READ CUST NEXT
000710     DISPLAY "NEXT AFTER END  " FS
000720     MOVE "BOSTON" TO CUST-CITY
000730     START CUST KEY = CUST-CITY
000740     DISPLAY "START CITY      " FS
000750     READ CUST NEXT DISPLAY "  " FS " " CUST-REC
000760     READ CUST NEXT DISPLAY "  " FS " " CUST-REC
000770     READ CUST NEXT DISPLAY "  " FS " " CUST-REC
000780     MOVE "AUSTIN" TO CUST-CITY
000790     READ CUST KEY IS CUST-CITY
000800     DISPLAY "READ BY CITY    " FS " " CUST-REC
000810     MOVE 1001 TO CUST-ID READ CUST
000820     MOVE "AUSTIN" TO CUST-CITY
000830     REWRITE CUST-REC
000840     DISPLAY "REWRITE TO DUP  " FS
000850     MOVE 1003 TO CUST-ID
000860     DELETE CUST
000870     DISPLAY "DELETE 1003     " FS
000880     DELETE CUST INVALID KEY DISPLAY "DELETE AGAIN    " FS
000890     END-DELETE
000900     MOVE 1001 TO CUST-ID
000910     START CUST KEY > CUST-ID
000920     READ CUST NEXT
000930     DISPLAY "START > 1001    " FS " " CUST-REC
000940     READ CUST PREVIOUS
000950     DISPLAY "PREVIOUS        " FS " " CUST-REC
000960     CLOSE CUST
000970     OPEN INPUT CUST
000980     MOVE 0 TO CUST-ID
000990     START CUST KEY >= CUST-ID
001000     PERFORM READ-ALL
001010     CLOSE CUST
001020*    same file, different key layout
