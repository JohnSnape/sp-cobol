000010* Relative files: random, dynamic and sequential access,
000020* START, REWRITE, DELETE, and the slot format on disk.
000030 IDENTIFICATION DIVISION.
000040 PROGRAM-ID. FILEREL.
000050 ENVIRONMENT DIVISION.
000060 INPUT-OUTPUT SECTION.
000070 FILE-CONTROL.
000080     SELECT RELF ASSIGN TO "parts.rel"
000090        ORGANIZATION RELATIVE ACCESS DYNAMIC
000100        RELATIVE KEY RK FILE STATUS FS.
000110     SELECT RELS ASSIGN TO "seq.rel"
000120        ORGANIZATION RELATIVE ACCESS SEQUENTIAL
000130        RELATIVE KEY SK FILE STATUS FS.
000140 DATA DIVISION.
000150 FILE SECTION.
000160 FD RELF.
000170 01 PART.
000180    05 PART-NAME   PIC X(12).
000190    05 PART-QTY    PIC 9(4).
000200 FD RELS.
000210 01 SREC           PIC X(8).
000220 WORKING-STORAGE SECTION.
000230 01 FS             PIC XX.
000240 01 RK             PIC 9(4).
000250 01 SK             PIC 9(4).
000260 01 EOF-FLAG       PIC X VALUE "N".
000270    88 AT-EOF      VALUE "Y".
000280 PROCEDURE DIVISION.
000290 MAIN-PARA.
000300     OPEN OUTPUT RELF
000310     MOVE 3 TO RK MOVE "BOLT" TO PART-NAME MOVE 120 TO PART-QTY
000320     WRITE PART INVALID KEY DISPLAY "BAD 3" END-WRITE
000330     MOVE 1 TO RK MOVE "NUT" TO PART-NAME MOVE 75 TO PART-QTY
000340     WRITE PART
000350     MOVE 6 TO RK MOVE "WASHER" TO PART-NAME MOVE 9 TO PART-QTY
000360     WRITE PART
000370     DISPLAY "WRITES          " FS
000380     MOVE 3 TO RK
000390     WRITE PART INVALID KEY DISPLAY "DUPLICATE       " FS
000400     END-WRITE
000410     MOVE 0 TO RK
000420     WRITE PART INVALID KEY DISPLAY "KEY ZERO        " FS
000430     END-WRITE
000440     CLOSE RELF
000450     OPEN I-O RELF
000460     MOVE 3 TO RK
000470     READ RELF INVALID KEY DISPLAY "NO 3"
000480        NOT INVALID KEY DISPLAY "READ 3          " PART
000490     END-READ
000500     MOVE 2 TO RK
000510     READ RELF INVALID KEY DISPLAY "READ 2 MISSING  " FS
000520     END-READ
000530     MOVE 99 TO RK
000540     READ RELF INVALID KEY DISPLAY "READ 99 MISSING " FS
000550     END-READ
000560     MOVE 3 TO RK READ RELF
000570     ADD 5 TO PART-QTY
000580     REWRITE PART
000590     DISPLAY "REWRITE 3       " FS
000600     MOVE 1 TO RK
000610     DELETE RELF
000620     DISPLAY "DELETE 1        " FS
000630     MOVE 2 TO RK
000640     START RELF KEY >= RK
000650     DISPLAY "START >= 2      " FS
000660     PERFORM UNTIL AT-EOF
000670        READ RELF NEXT
000680           AT END SET AT-EOF TO TRUE
000690           NOT AT END DISPLAY "  " RK " " PART
000700        END-READ
000710     END-PERFORM
000720     MOVE 7 TO RK
000730     START RELF KEY > RK
000740        INVALID KEY DISPLAY "START > 7       " FS
000750     END-START
000760     MOVE 5 TO RK
000770     START RELF KEY < RK
000780     READ RELF NEXT
000790     DISPLAY "START < 5       " RK " " PART
000800     CLOSE RELF
000810*    ---- sequential access: slots numbered as written
000820     OPEN OUTPUT RELS
000830     MOVE "ALPHA" TO SREC WRITE SREC
000840     MOVE "BETA" TO SREC WRITE SREC
000850     MOVE "GAMMA" TO SREC WRITE SREC
000860     DISPLAY "SEQ WRITES      " FS " LAST KEY " SK
000870     CLOSE RELS
000880     OPEN I-O RELS
000890     MOVE "N" TO EOF-FLAG
000900     PERFORM UNTIL AT-EOF
000910        READ RELS
000920           AT END SET AT-EOF TO TRUE
000930           NOT AT END
000940              DISPLAY "  " SK " " SREC
000950              IF SK = 2
000960                 DELETE RELS
000970                 DISPLAY "  DELETE        " FS
000980              END-IF
000990        END-READ
001000     END-PERFORM
001010     CLOSE RELS
001020     OPEN INPUT RELS
001030     MOVE "N" TO EOF-FLAG
001040     PERFORM UNTIL AT-EOF
001050        READ RELS AT END SET AT-EOF TO TRUE
001060           NOT AT END DISPLAY "  AFTER " SK " " SREC
001070        END-READ
001080     END-PERFORM
001090     CLOSE RELS
001100     STOP RUN.
