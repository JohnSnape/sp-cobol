000010* Sequential and line sequential files: every status DISPLAYed,
000020* and the files left behind compared byte for byte with stock.
000030 IDENTIFICATION DIVISION.
000040 PROGRAM-ID. FILESEQ.
000050 ENVIRONMENT DIVISION.
000060 INPUT-OUTPUT SECTION.
000070 FILE-CONTROL.
000080     SELECT SEQF ASSIGN TO "seqfix.dat"
000090        ORGANIZATION SEQUENTIAL FILE STATUS FS.
000100     SELECT VARF ASSIGN TO "seqvar.dat"
000110        ORGANIZATION SEQUENTIAL FILE STATUS FS.
000120     SELECT LINEF ASSIGN TO "lines.txt"
000130        ORGANIZATION LINE SEQUENTIAL FILE STATUS FS.
000140     SELECT WIDEF ASSIGN TO "lines.txt"
000150        ORGANIZATION LINE SEQUENTIAL FILE STATUS FS.
000160     SELECT OPTIONAL MISSF ASSIGN TO "nothere.dat"
000170        ORGANIZATION SEQUENTIAL FILE STATUS FS.
000180     SELECT PRTF ASSIGN TO "report.txt"
000190        ORGANIZATION LINE SEQUENTIAL FILE STATUS FS.
000200 DATA DIVISION.
000210 FILE SECTION.
000220 FD SEQF.
000230 01 SREC           PIC X(10).
000240 FD VARF RECORD VARYING 3 TO 30 DEPENDING ON VLEN.
000250 01 VREC           PIC X(30).
000260 FD LINEF.
000270 01 LREC           PIC X(12).
000280 FD WIDEF.
000290 01 WREC           PIC X(40).
000300 FD MISSF.
000310 01 MREC           PIC X(5).
000320 FD PRTF.
000330 01 PREC           PIC X(20).
000340 WORKING-STORAGE SECTION.
000350 01 FS             PIC XX.
000360 01 VLEN           PIC 99.
000370 01 N              PIC 99.
000380 01 EOF-FLAG       PIC X VALUE "N".
000390    88 AT-EOF      VALUE "Y".
000400 PROCEDURE DIVISION.
000410 MAIN-PARA.
000420     DELETE FILE MISSF
000430     DISPLAY "DELETE MISSING  " FS
000440*    ---- fixed sequential
000450     OPEN OUTPUT SEQF
000460     DISPLAY "OPEN OUTPUT     " FS
000470     OPEN OUTPUT SEQF
000480     DISPLAY "OPEN AGAIN      " FS
000490     MOVE "FIRST" TO SREC WRITE SREC
000500     MOVE "SECOND" TO SREC WRITE SREC
000510     MOVE "THIRD" TO SREC WRITE SREC
000520     DISPLAY "WRITE           " FS
000530     READ SEQF
000540     DISPLAY "READ ON OUTPUT  " FS
000550     CLOSE SEQF
000560     DISPLAY "CLOSE           " FS
000570     CLOSE SEQF
000580     DISPLAY "CLOSE AGAIN     " FS
000590     READ SEQF
000600     DISPLAY "READ CLOSED     " FS
000610     OPEN EXTEND SEQF
000620     MOVE "FOURTH" TO SREC WRITE SREC
000630     DISPLAY "EXTEND WRITE    " FS
000640     CLOSE SEQF
000650     OPEN I-O SEQF
000660     REWRITE SREC
000670     DISPLAY "REWRITE NO READ " FS
000680     READ SEQF
000690     MOVE "1ST" TO SREC
000700     REWRITE SREC
000710     DISPLAY "REWRITE         " FS
000720     WRITE SREC
000730     DISPLAY "WRITE ON I-O    " FS
000740     CLOSE SEQF
000750     OPEN INPUT SEQF
000760     PERFORM UNTIL AT-EOF
000770        READ SEQF
000780           AT END SET AT-EOF TO TRUE
000790           NOT AT END DISPLAY "  [" SREC "] " FS
000800        END-READ
000810     END-PERFORM
000820     DISPLAY "AT END          " FS
000830     READ SEQF
000840     DISPLAY "READ AFTER END  " FS
000850     CLOSE SEQF
000860*    ---- variable sequential
000870     OPEN OUTPUT VARF
000880     MOVE 3 TO VLEN MOVE "ABC" TO VREC WRITE VREC
000890     MOVE 7 TO VLEN MOVE "DEFGHIJ" TO VREC WRITE VREC
000900     MOVE 30 TO VLEN MOVE ALL "Z" TO VREC WRITE VREC
000910     MOVE 2 TO VLEN WRITE VREC
000920     DISPLAY "VAR TOO SHORT   " FS
000930     CLOSE VARF
000940     OPEN INPUT VARF
000950     MOVE "N" TO EOF-FLAG
000960     PERFORM UNTIL AT-EOF
000970        MOVE SPACES TO VREC
000980        READ VARF
000990           AT END SET AT-EOF TO TRUE
001000           NOT AT END DISPLAY "  " VLEN " [" VREC "]"
001010        END-READ
001020     END-PERFORM
001030     CLOSE VARF
001040*    ---- line sequential: trailing spaces, empty line, long line
001050     OPEN OUTPUT LINEF
001060     MOVE "ONE" TO LREC WRITE LREC
001070     MOVE SPACES TO LREC WRITE LREC
001080     MOVE "  INDENTED" TO LREC WRITE LREC
001090     CLOSE LINEF
001100     OPEN EXTEND WIDEF
001110     MOVE "THIS LINE IS FAR TOO LONG FOR LREC" TO WREC
001120     WRITE WREC
001130     CLOSE WIDEF
001140     OPEN INPUT LINEF
001150     MOVE "N" TO EOF-FLAG
001160     PERFORM UNTIL AT-EOF
001170        READ LINEF
001180           AT END SET AT-EOF TO TRUE
001190           NOT AT END DISPLAY "  [" LREC "] " FS
001200        END-READ
001210     END-PERFORM
001220     CLOSE LINEF
001230*    ---- OPTIONAL file that isn't there
001240     OPEN INPUT MISSF
001250     DISPLAY "OPEN OPTIONAL   " FS
001260     READ MISSF AT END DISPLAY "  AT END " FS END-READ
001270     READ MISSF AT END DISPLAY "  AT END " FS END-READ
001280     DISPLAY "READ AGAIN      " FS
001290     CLOSE MISSF
001300     DISPLAY "CLOSE OPTIONAL  " FS
001310*    ---- WRITE ADVANCING
001320     OPEN OUTPUT PRTF
001330     MOVE "TITLE" TO PREC
001340     WRITE PREC AFTER ADVANCING PAGE
001350     MOVE "AFTER 2" TO PREC
001360     WRITE PREC AFTER ADVANCING 2 LINES
001370     MOVE "BEFORE 1" TO PREC
001380     WRITE PREC BEFORE ADVANCING 1 LINE
001390     MOVE "PLAIN" TO PREC
001400     WRITE PREC
001410     MOVE "BEFORE PAGE" TO PREC
001420     WRITE PREC BEFORE ADVANCING PAGE
001430     CLOSE PRTF
001440     DISPLAY "REPORT          " FS
001450     STOP RUN.
