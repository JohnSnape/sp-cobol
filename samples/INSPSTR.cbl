000010* INSPECT (TALLYING, REPLACING, CONVERTING) and UNSTRING,
000020* compared with stock GnuCOBOL. UNSTRING into a JUSTIFIED RIGHT
000030* field fills it from the left in stock 3.2 (MOVE justifies).
000040 IDENTIFICATION DIVISION.
000050 PROGRAM-ID. INSPSTR.
000060 DATA DIVISION.
000070 WORKING-STORAGE SECTION.
000080 01 TEXT1          PIC X(30).
000090 01 T1             PIC 99.
000100 01 T2             PIC 99.
000110 01 T3             PIC 99.
000120 01 SNUM           PIC S9(5) VALUE -12341.
000130 01 SHOWN          PIC -9(5).
000140 01 LOWER          PIC X(26) VALUE "abcdefghijklmnopqrstuvwxyz".
000150 01 UPPER          PIC X(26) VALUE "ABCDEFGHIJKLMNOPQRSTUVWXYZ".
000160 01 CSV            PIC X(40)
000170                   VALUE "SMITH,JOHN,,SAN DIEGO,92101".
000180 01 F1             PIC X(8).
000190 01 F2             PIC X(8).
000200 01 F3             PIC X(8).
000210 01 F4             PIC X(8).
000220 01 F5             PIC 9(7).
000230 01 C1             PIC 99.
000240 01 C2             PIC 99.
000250 01 D1             PIC X.
000260 01 D2             PIC XX.
000270 01 PTR            PIC 99.
000280 01 CNT            PIC 99.
000290 01 RJ             PIC X(8) JUSTIFIED RIGHT.
000300 PROCEDURE DIVISION.
000310 MAIN-PARA.
000320*    ---- TALLYING
000330     MOVE "  BANANA ABBA, AND MORE  " TO TEXT1
000340     MOVE 0 TO T1 T2 T3
000350     INSPECT TEXT1 TALLYING T1 FOR ALL "A"
000360                            T2 FOR LEADING SPACES
000370                            T3 FOR CHARACTERS
000380     DISPLAY "TALLY 1  " T1 " " T2 " " T3
000390     MOVE 0 TO T1 T2
000400     INSPECT TEXT1 TALLYING T1 FOR ALL "AB" T2 FOR ALL "A"
000410     DISPLAY "TALLY 2  " T1 " " T2
000420     MOVE 0 TO T1 T2 T3
000430     INSPECT TEXT1 TALLYING T1 FOR ALL "A" BEFORE INITIAL ","
000440                            T2 FOR ALL "A" AFTER INITIAL ","
000450                            T3 FOR TRAILING SPACES
000460     DISPLAY "TALLY 3  " T1 " " T2 " " T3
000470     MOVE 0 TO T1
000480     INSPECT TEXT1 TALLYING T1 FOR CHARACTERS
000490              AFTER INITIAL "B" BEFORE INITIAL ","
000500     DISPLAY "TALLY 4  " T1
000510*    ---- REPLACING
000520     MOVE "000123 XXAXX: ABAB-Q-ABAB" TO TEXT1
000530     INSPECT TEXT1 REPLACING LEADING "0" BY SPACE
000540                             FIRST "X" BY "Y"
000550                             ALL "AB" BY "xy" BEFORE INITIAL "Q"
000560     DISPLAY "REPL 1   [" TEXT1 "]"
000570     INSPECT TEXT1 REPLACING CHARACTERS BY "*" AFTER INITIAL ":"
000580     DISPLAY "REPL 2   [" TEXT1 "]"
000590     MOVE "TRAIL" TO TEXT1
000600     INSPECT TEXT1 REPLACING TRAILING SPACES BY "."
000610     DISPLAY "REPL 3   [" TEXT1 "]"
000620     MOVE "AABBAABB" TO TEXT1
000630     INSPECT TEXT1 REPLACING ALL "AA" BY "ZZ"
000640     DISPLAY "REPL 4   [" TEXT1 "]"
000650     MOVE 0 TO T1
000660     MOVE "HELLO WORLD" TO TEXT1
000670     INSPECT TEXT1 TALLYING T1 FOR ALL "L"
000680                   REPLACING ALL "L" BY "1"
000690     DISPLAY "BOTH     " T1 " [" TEXT1 "]"
000700     INSPECT SNUM REPLACING ALL "1" BY "7"
000710     MOVE SNUM TO SHOWN
000720     DISPLAY "SIGNED   " SHOWN
000730*    ---- CONVERTING
000740     MOVE "Mixed Case, mostly lower" TO TEXT1
000750     INSPECT TEXT1 CONVERTING LOWER TO UPPER
000760     DISPLAY "CONV 1   [" TEXT1 "]"
000770     MOVE "a-b-c|a-b-c" TO TEXT1
000780     INSPECT TEXT1 CONVERTING "abc" TO "xyz" AFTER INITIAL "|"
000790     DISPLAY "CONV 2   [" TEXT1 "]"
000800     MOVE "a1b2c3" TO TEXT1
000810     INSPECT TEXT1 CONVERTING "123" TO "###"
000820     DISPLAY "CONV 3   [" TEXT1 "]"
000830*    ---- UNSTRING
000840     MOVE 0 TO CNT
000850     UNSTRING CSV DELIMITED BY ","
000860        INTO F1 COUNT IN C1
000870             F2 COUNT IN C2
000880             F3 DELIMITER IN D1
000890             F4
000900             F5
000910        TALLYING IN CNT
000920        ON OVERFLOW DISPLAY "OVERFLOW?"
000930        NOT ON OVERFLOW DISPLAY "UNSTR 1  NO OVERFLOW"
000940     END-UNSTRING
000950     DISPLAY "  [" F1 "][" F2 "][" F3 "][" F4 "][" F5 "]"
000960     DISPLAY "  COUNTS " C1 " " C2 " DLM [" D1 "] FIELDS " CNT
000970     MOVE "ONE   TWO  THREE FOUR" TO TEXT1
000980     MOVE 1 TO PTR
000990     UNSTRING TEXT1 DELIMITED BY ALL SPACE
001000        INTO F1 F2 F3
001010        WITH POINTER PTR
001020        ON OVERFLOW DISPLAY "UNSTR 2  OVERFLOW, POINTER " PTR
001030     END-UNSTRING
001040     DISPLAY "  [" F1 "][" F2 "][" F3 "]"
001050     MOVE "A/B;C//D" TO TEXT1
001060     UNSTRING TEXT1 DELIMITED BY "/" OR ";" OR "//"
001070        INTO F1 DELIMITER IN D2 F2 DELIMITER IN D1 F3 F4
001080     DISPLAY "UNSTR 3  [" F1 "][" D2 "][" F2 "][" D1 "]["
001090             F3 "][" F4 "]"
001100     MOVE "ABCDEFGHIJKL" TO TEXT1
001110     UNSTRING TEXT1 INTO F1 RJ
001120     DISPLAY "UNSTR 4  [" F1 "][" RJ "]"
001130     MOVE "AB" TO RJ
001140     DISPLAY "MOVE RJ  [" RJ "]"
001150     MOVE F1(5:4) TO RJ
001160     DISPLAY "MOVE RJ  [" RJ "]"
001170     MOVE 50 TO PTR
001180     UNSTRING TEXT1 DELIMITED BY "," INTO F1 WITH POINTER PTR
001190        ON OVERFLOW DISPLAY "UNSTR 5  BAD POINTER " PTR
001200     END-UNSTRING
001210     STOP RUN.
