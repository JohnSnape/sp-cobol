000010 IDENTIFICATION DIVISION.
000020 PROGRAM-ID. POINTERS.
000030 DATA DIVISION.
000040 WORKING-STORAGE SECTION.
000050 01  P   USAGE POINTER VALUE NULL.
000060 01  Q   USAGE POINTER.
000070 01  X   PIC X(5) VALUE "ABCDE".
000080 LINKAGE SECTION.
000090 01  L   PIC X(5).
000100 PROCEDURE DIVISION.
000110     IF P = NULL DISPLAY "P NULL" END-IF
000120     SET Q TO ADDRESS OF X
000130     SET ADDRESS OF L TO Q
000140     DISPLAY L
000150     SET Q TO NULL
000160     IF Q = NULL DISPLAY "Q NULL" END-IF
000170     SET P TO ADDRESS OF X
000180     IF P = Q DISPLAY "SAME" ELSE DISPLAY "DIFF" END-IF
000190     STOP RUN.
